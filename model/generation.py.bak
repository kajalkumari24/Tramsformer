"""Autoregressive text generation: greedy, temperature and top-k sampling."""

import torch
import torch.nn.functional as F


@torch.no_grad()
def generate(model, idx, max_new_tokens, context_length,
             temperature=1.0, top_k=None, generator=None):
    """Extend idx (batch, time) by max_new_tokens tokens, one token at a time.

    temperature == 0  -> greedy decoding (always the most likely token)
    temperature  > 0  -> sample; below 1 is more cautious, above 1 more random
    top_k             -> only sample among the k most likely tokens
    generator         -> optional torch.Generator (on the same device as the
                         model) for reproducible sampling
    """
    if max_new_tokens < 0:
        raise ValueError("max_new_tokens must be 0 or more.")
    if temperature < 0:
        raise ValueError("temperature must be 0 or more.")
    if top_k is not None and top_k < 1:
        raise ValueError("top_k must be at least 1.")
    if context_length < 1:
        raise ValueError("context_length must be at least 1.")
    if idx.ndim != 2 or idx.shape[1] < 1:
        raise ValueError("idx must have shape (batch, time) with at least one token.")

    was_training = model.training
    model.eval()
    try:
        for _ in range(max_new_tokens):
            window = idx[:, -context_length:]          # the model only sees its context
            logits, _ = model(window)
            logits = logits[:, -1, :]                  # scores for the next token only

            if temperature == 0:
                next_id = torch.argmax(logits, dim=-1, keepdim=True)
            else:
                logits = logits / temperature
                if top_k is not None:
                    k = min(top_k, logits.size(-1))
                    kth_best = torch.topk(logits, k).values[:, -1, None]
                    logits = logits.masked_fill(logits < kth_best, float("-inf"))
                probs = F.softmax(logits, dim=-1)
                next_id = torch.multinomial(probs, num_samples=1, generator=generator)

            idx = torch.cat([idx, next_id], dim=1)
    finally:
        model.train(was_training)
    return idx


def generate_text(model, tokenizer, prompt, max_new_tokens, context_length, device,
                  temperature=0.8, top_k=40, seed=None):
    """Prompt string in, prompt + continuation string out."""
    try:
        ids = tokenizer.encode(prompt)
    except KeyError as error:
        raise ValueError(
            f"The prompt contains a character that is not in the vocabulary: {error}"
        ) from error
    if not ids:
        raise ValueError("The prompt is empty. Give at least one character.")

    idx = torch.tensor([ids], dtype=torch.long, device=device)
    generator = None
    if seed is not None:
        generator = torch.Generator(device=device)
        generator.manual_seed(seed)

    out = generate(model, idx, max_new_tokens, context_length,
                   temperature=temperature, top_k=top_k, generator=generator)
    return tokenizer.decode(out[0].tolist())
