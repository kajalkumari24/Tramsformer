"""Training loop with evaluation, gradient clipping, and checkpoints."""

import math
import time
from pathlib import Path

import torch

from .checkpoint import load_checkpoint, save_checkpoint
from .data import get_batch


def get_lr(step, max_steps, base_lr, warmup_steps, min_ratio=0.1):
    """Linear warmup followed by cosine decay."""
    min_lr = base_lr * min_ratio

    if warmup_steps > 0 and step < warmup_steps:
        return base_lr * (step + 1) / warmup_steps

    if step >= max_steps:
        return min_lr

    progress = (step - warmup_steps) / max(
        1, max_steps - warmup_steps
    )
    progress = min(1.0, max(0.0, progress))
    cosine = 0.5 * (1.0 + math.cos(math.pi * progress))

    return min_lr + cosine * (base_lr - min_lr)


@torch.no_grad()
def estimate_loss(model, data, batch_size, context_length, eval_iters):
    """Average loss over several batches with dropout disabled."""
    if eval_iters < 1:
        raise ValueError("eval_iters must be at least 1.")

    was_training = model.training
    model.eval()
    losses = []

    try:
        for _ in range(eval_iters):
            x, y = get_batch(data, batch_size, context_length)
            _, loss = model(x, y)

            if loss is None or not torch.isfinite(loss):
                raise RuntimeError("Evaluation produced an invalid loss.")

            losses.append(loss.item())
    finally:
        model.train(was_training)

    return sum(losses) / len(losses)


class Trainer:
    def __init__(
        self,
        model,
        train_data,
        val_data,
        train_cfg,
        model_cfg,
        device,
        checkpoint_dir,
    ):
        self.model = model.to(device)
        self.train_data = train_data.to(device)
        self.val_data = val_data.to(device)
        self.train_cfg = train_cfg
        self.model_cfg = model_cfg
        self.device = device
        self.checkpoint_dir = Path(checkpoint_dir)
        self.best_val_loss = float("inf")
        self.history = []

        if train_cfg.eval_interval < 1:
            raise ValueError("eval_interval must be at least 1.")
        if train_cfg.eval_iters < 1:
            raise ValueError("eval_iters must be at least 1.")
        if train_cfg.grad_clip <= 0:
            raise ValueError("grad_clip must be positive.")

        # Apply weight decay to matrix parameters, not biases or LayerNorm.
        decay = [
            p for p in self.model.parameters()
            if p.requires_grad and p.dim() >= 2
        ]
        no_decay = [
            p for p in self.model.parameters()
            if p.requires_grad and p.dim() < 2
        ]

        self.optimizer = torch.optim.AdamW(
            [
                {
                    "params": decay,
                    "weight_decay": train_cfg.weight_decay,
                },
                {
                    "params": no_decay,
                    "weight_decay": 0.0,
                },
            ],
            lr=train_cfg.learning_rate,
        )

    def _save(self, name, step, best_val, history):
        save_checkpoint(
            self.checkpoint_dir / name,
            self.model,
            self.optimizer,
            step,
            best_val,
            self.model_cfg,
            self.train_cfg,
            history,
        )

    def train(self, max_steps=None, resume_from=None, log=print):
        cfg = self.train_cfg
        max_steps = cfg.max_steps if max_steps is None else max_steps

        if max_steps < 1:
            raise ValueError("max_steps must be at least 1.")

        warmup = min(100, max(1, max_steps // 10))
        context = self.model_cfg.context_length

        start_step = 0
        best_val = float("inf")
        history = []

        if resume_from is not None:
            ckpt = load_checkpoint(resume_from, self.device)
            self.model.load_state_dict(ckpt["model_state"])
            self.optimizer.load_state_dict(ckpt["optimizer_state"])

            start_step = int(ckpt["step"])
            best_val = float(ckpt["best_val_loss"])
            history = list(ckpt.get("history", []))

            if start_step >= max_steps:
                log(
                    f"Checkpoint step {start_step} has already reached "
                    f"max_steps={max_steps}."
                )
                self.best_val_loss = best_val
                self.history = history
                return history

            log(
                f"Resuming from step {start_step}; "
                f"best validation loss {best_val:.4f}"
            )

        self.model.train()
        began = time.time()

        for step in range(start_step, max_steps + 1):
            lr = get_lr(
                step,
                max_steps,
                cfg.learning_rate,
                warmup,
            )

            for group in self.optimizer.param_groups:
                group["lr"] = lr

            if step % cfg.eval_interval == 0 or step == max_steps:
                train_loss = estimate_loss(
                    self.model,
                    self.train_data,
                    cfg.batch_size,
                    context,
                    cfg.eval_iters,
                )
                val_loss = estimate_loss(
                    self.model,
                    self.val_data,
                    cfg.batch_size,
                    context,
                    cfg.eval_iters,
                )

                history.append(
                    {
                        "step": step,
                        "train_loss": train_loss,
                        "val_loss": val_loss,
                        "lr": lr,
                    }
                )

                marker = ""
                if val_loss < best_val:
                    best_val = val_loss
                    self._save("best.pt", step, best_val, history)
                    marker = " <- best"

                self._save("last.pt", step, best_val, history)

                log(
                    f"step {step:5d} | train {train_loss:.4f} "
                    f"| val {val_loss:.4f} | lr {lr:.2e} "
                    f"| {time.time() - began:5.0f}s{marker}"
                )

            if step == max_steps:
                break

            x, y = get_batch(
                self.train_data,
                cfg.batch_size,
                context,
            )

            _, loss = self.model(x, y)

            if loss is None or not torch.isfinite(loss):
                raise RuntimeError(
                    f"Invalid loss at step {step}: "
                    f"{None if loss is None else loss.item()}"
                )

            self.optimizer.zero_grad(set_to_none=True)
            loss.backward()

            torch.nn.utils.clip_grad_norm_(
                self.model.parameters(),
                cfg.grad_clip,
            )

            self.optimizer.step()

        self.best_val_loss = best_val
        self.history = history

        return history
