"""Prompt formatting for a character-level model trained on play-like text."""

import re
from typing import Iterable, Mapping

USER_LABEL = "YOU"
BOT_LABEL = "BOT"


def _clean(content: str) -> str:
    content = str(content).replace("\r\n", "\n").replace("\r", "\n")
    content = re.sub(r"\n{3,}", "\n\n", content)
    return content.strip()


def build_chat_prompt(messages: Iterable[Mapping], max_chars: int = 2000) -> str:
    if max_chars < 1:
        raise ValueError("max_chars must be positive")

    formatted = []
    for message in messages:
        role = str(message.get("role", "")).lower()
        content = _clean(message.get("content", ""))

        if not content:
            continue

        if role == "user":
            label = USER_LABEL
        elif role == "assistant":
            label = BOT_LABEL
        else:
            continue

        formatted.append(f"{label}: {content}")

    # Reserve room for the next assistant label.
    suffix = f"{BOT_LABEL}:\n"
    budget = max(0, max_chars - len(suffix))
    body = "\n".join(formatted)

    if len(body) > budget:
        body = body[-budget:] if budget else ""

        # Avoid beginning with a partial line where possible.
        if "\n" in body:
            body = body.split("\n", 1)[1]

    return body + ("\n" if body else "") + suffix


def extract_reply(generated: str) -> str:
    """Extract generated text after the final BOT: prompt marker."""
    text = str(generated).replace("\\r\\n", "\\n").replace("\\r", "\\n")

    # The model output includes the prompt. Keep only text after the final BOT: marker.
    marker = "BOT:"
    marker_pos = text.rfind(marker)
    if marker_pos >= 0:
        text = text[marker_pos + len(marker):]

    text = text.lstrip()

    # Stop if the model starts generating another speaker's turn.
    match = re.search(r"\\n(?:YOU|BOT):", text)
    if match:
        text = text[:match.start()]

    return text.strip()
